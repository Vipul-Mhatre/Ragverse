  {
    "document_id": "eng-api-architecture-2026",
    "chunk_id": "eng-api-architecture-2026-c2",
    "source": "engineering",
    "content": "System Topology: The platform is composed of three core services: identity, retrieval, and analytics. Requests enter through the API gateway, which performs token validation and RBAC enforcement before routing to downstream services.",
