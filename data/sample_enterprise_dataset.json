    ]
  },
  {
    "document_id": "eng-api-architecture-2026",
    "chunk_id": "eng-api-architecture-2026-c3",
    "source": "engineering",
    "content": "Service Boundaries: 1. Identity Service - Handles JWT issuance and token introspection - Enforces session expiration and role claims",
