  },
  {
    "document_id": "eng-api-architecture-2026",
    "chunk_id": "eng-api-architecture-2026-c4",
    "source": "engineering",
    "content": "2. Retrieval Service - Runs hybrid retrieval using vector similarity and BM25 - Reranks top candidates before sending to the LLM layer",
    "metadata": {
      "source": "engineering",
      "classification": "internal",
      "allowed_roles": [
        "engineering_analyst",
        "engineering_manager",
        "admin"
